# ---- core ----
APP_NAME=DocuPilot AI
APP_ENV=development
MODEL_DIR=data/models
CORPUS_PATH=data/processed/corpus.json
FEEDBACK_PATH=data/processed/feedback.jsonl
TRAINING_DATA_PATH=data/raw/training_documents.json

# ---- multi-tenancy ----
DEFAULT_TENANT=public

# ---- vector store: memory | pgvector ----
VECTOR_BACKEND=memory
# embedder: tfidf | sentence-transformers
EMBEDDING_BACKEND=tfidf
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
DATABASE_URL=postgresql://docupilot:docupilot@localhost:5432/docupilot

# ---- OCR ----
OCR_ENABLED=true
OCR_LANG=eng
OCR_DPI=200

# ---- extraction: rules | ner | llm ----
EXTRACTION_BACKEND=rules
SPACY_MODEL=en_core_web_sm
# LLM provider: none | openai | anthropic
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- auth / RBAC ----
AUTH_ENABLED=false
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=60
DEMO_USERS=admin:admin123:admin:public,analyst:analyst123:analyst:public,viewer:viewer123:viewer:public

# ---- MLOps / observability ----
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=docupilot-classifier
PROMETHEUS_ENABLED=true
DRIFT_THRESHOLD=0.2

# ---- async workflows: background | celery ----
TASK_BACKEND=background
CELERY_BROKER_URL=redis://localhost:6379/0
